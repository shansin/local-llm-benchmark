# The measurement protocol is fixed in code: sampling pinned at temperature 0,
# every prompt asking for the final answer inside <answer></answer>, and each
# model's thinking mode established by a per-model preflight. What remains
# configurable is what genuinely varies between machines and runs.

# Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Models to benchmark (comma-separated, or "all", or empty to pick interactively)
BENCHMARK_MODELS=

# Judge panel: comma-separated model names (empty to pick interactively).
# With more than one, the verdict is the median across judges, so no single
# model's taste decides the leaderboard. A model never scores its own answers;
# if that leaves a task without an independent judge, it goes unscored.
# JUDGE_MODEL (singular) also works.
JUDGE_MODELS=

# Output directory
OUTPUT_DIR=./output

# Timeout per prompt in seconds (default: 2700 = 45 minutes). Size to your
# hardware: the slowest model's hardest task has to finish inside it.
PROMPT_TIMEOUT=2700

# Context window. A fact about your hardware, not a tuning choice — size it as
# large as the KV cache affords. Too small and a reasoning model spends the
# whole window thinking, the answer never starts, and the report can only score
# it as missing. The report's "Truncated" column tells you when to raise it.
NUM_CTX=65536

# Set to 0 to never execute model-generated code; coding tasks then fall back
# to judge-only scoring. Execution is sandboxed (temp dir, scrubbed env,
# rlimits, timeout, no network where the kernel allows it) but it is still
# running code a language model wrote.
CODE_EXEC=1
