# Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Models to benchmark (comma-separated, or "all" to benchmark all, empty to prompt interactively)
BENCHMARK_MODELS=

# Judge panel: comma-separated model names (empty to prompt interactively).
# With more than one, the verdict is the median across judges, so no single
# model's taste decides the leaderboard. JUDGE_MODEL (singular) also works.
JUDGE_MODELS=

# A model never scores its own answers unless this is turned on. Its score for
# itself is not an independent measurement. If a model's only judge is itself,
# the task is left unscored rather than scored by an interested party.
ALLOW_SELF_JUDGE=0

# Output directory
OUTPUT_DIR=./output

# Timeout per prompt in seconds (default: 2700 = 45 minutes)
PROMPT_TIMEOUT=2700

# Timeout per judge call in seconds (default: 1800 = 30 minutes)
JUDGE_TIMEOUT=1800

# --- Sampling ---
# Pinned so runs are reproducible. Ollama's own defaults sample at temperature
# 0.8 with no seed, which makes leaderboard differences unreadable.
TEMPERATURE=0.0
TOP_P=1.0
TOP_K=40
SEED=0
# Must be set explicitly: left unset, Ollama picks a per-model default and
# silently truncates longer prompts.
NUM_CTX=8192

# Times each prompt is answered. The spread across repeats is the noise floor
# that any difference between models has to clear. 1 gives no noise estimate.
QUALITY_REPEATS=3

# Retries on connection errors (timeouts are never retried — they are data).
RETRIES=3

# --- Objective scoring ---
# Tasks can carry deterministic checks (exact answers, word counts, forbidden
# patterns, and for coding tasks a real test suite run against the generated code).
# Weight of those checks in the blended score; the judge supplies the rest.
OBJECTIVE_WEIGHT=0.6

# Set to 0 to never execute model-generated code. Coding tasks then fall back to
# judge-only scoring. Execution is sandboxed (temp dir, scrubbed env, rlimits,
# timeout, no network where the kernel allows it) but it is still running code
# a language model wrote.
CODE_EXEC=1

# --- Throughput probe ---
# Measures tokens/s with a short fixed generation instead of inferring it from
# however long each benchmark answer happened to be.
PERF_PROBE=true
PERF_REPEATS=5
PERF_PREDICT_TOKENS=256

# Prefill scaling: input lengths (in tokens) to measure prompt-ingestion speed at.
# Lengths beyond NUM_CTX are skipped rather than silently truncated.
PREFILL_SWEEP=512,4096,16384
PREFILL_REPEATS=2
